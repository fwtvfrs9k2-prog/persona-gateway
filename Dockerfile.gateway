# Gateway-only image (fallback if combined image build fails).
# Render Web Service from Git: Dockerfile path = Dockerfile.gateway
# Env vars to set in Render:
#   PERSONA_SYSTEM_PROMPT = placeholder persona text (see gateway.py default)
#   UPSTREAM_BASE_URL = https://sub2api-rg8f.onrender.com/v1
#   SUB_INTERNAL_URL = (leave empty for separate service)
FROM python:3.12-slim
WORKDIR /app
COPY gateway.py requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
CMD ["sh", "-c", "uvicorn gateway:app --host 0.0.0.0 --port ${PORT:-10000}"]
